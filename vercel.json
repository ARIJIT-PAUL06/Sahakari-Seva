{
  "installCommand": "npm --prefix Sahakari-Seva-main install",
  "buildCommand": "npm --prefix Sahakari-Seva-main run build:web",
  "outputDirectory": "Sahakari-Seva-main/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!static_expo|_expo|assets|favicon\\.ico).*)*",
      "destination": "/index.html"
    }
  ]
}
